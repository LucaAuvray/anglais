# Copier en .env (développement) ou dans le fichier d'environnement du service (production).
PORT=3010
# Base, audios et verrou de préparation. Défaut : server/data
# DATA_DIR=/var/lib/anglais
# Interface construite (npm run build), servie par Express en production.
# STATIC_DIR=/opt/anglais/dist

# Mnemo : le compte de Luca, par ses routes existantes.
MNEMO_URL=
MNEMO_EMAIL=
MNEMO_PASSWORD=

# Claude par l'abonnement : jeton créé par `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_EFFORT=low
