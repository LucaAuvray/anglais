[Unit]
Description=Anglais : application d'apprentissage de l'anglais (serveur web)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/anglais/server
# Jeton Claude, adresse et identifiants Mnemo (droits 600, hors du dépôt).
EnvironmentFile=/etc/anglais.env
Environment=DATA_DIR=/var/lib/anglais STATIC_DIR=/opt/anglais/dist
# claude (installé dans /root/.local/bin), curl et ffmpeg doivent être trouvés par le serveur et la préparation.
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
# La CLI claude range sa configuration dans $HOME, que systemd ne définit pas sans User=.
Environment=HOME=/root
ExecStart=/usr/local/bin/node src/index.ts
# Bac à sable (vérifié avec systemd-run le 11/11/2026 : claude, Kokoro, curl et la base fonctionnent) :
# système en lecture seule sauf les données et /root, où la CLI claude range sa configuration.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/anglais /root
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
